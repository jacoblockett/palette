{
	"name": "@jacoblockett/palette",
	"version": "1.0.0",
	"description": "A contrast-aware semantic UI palette generator based on seed colors.",
	"main": "dist/index.cjs",
	"module": "dist/index.mjs",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		}
	},
	"files": [
		"dist/",
		"LICENSE",
		"README.md"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jacoblockett/palette.git"
	},
	"scripts": {
		"build": "rollup -c",
		"dev:1": "vite --host 0.0.0.0 --open /demo/index.html",
		"dev:2": "vite --host 0.0.0.0 --open /demo/index_v2.html",
		"format": "prettier --write src demo scripts"
	},
	"keywords": [
		"palette",
		"colors",
		"UI",
		"generator",
		"wcag",
		"shades",
		"theme"
	],
	"author": "Jacob Lockett",
	"license": "MIT",
	"type": "module",
	"devDependencies": {
		"@rollup/plugin-commonjs": "^29.0.0",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-terser": "^1.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"cross-env": "^10.1.0",
		"prettier": "^3.8.3",
		"rollup": "^4.53.2",
		"rollup-plugin-copy": "^3.5.0",
		"rollup-plugin-css-only": "^4.5.5",
		"rollup-plugin-svelte": "^7.2.3",
		"svelte": "^5.55.8",
		"vite": "^8.0.13"
	}
}
